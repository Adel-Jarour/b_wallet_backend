{
  "openapi": "3.0.3",
  "info": {
    "title": "B-Wallet FinTech Backend API",
    "version": "1.0.0",
    "description": "Production-grade, double-entry financial wallet backend built with Node.js, Express, Supabase PostgreSQL, Argon2id PIN verification, and real-time messaging.",
    "contact": {
      "name": "B-Wallet Engineering Team",
      "email": "engineering@bwallet.dev"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.bwallet.dev",
      "description": "Staging / Production Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase-issued user JWT access token passed via Authorization: Bearer <token>"
      },
      "WebhookSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "Stripe-Signature",
        "description": "HMAC-SHA256 signature header for webhook payload authentication"
      }
    },
    "headers": {
      "X-Correlation-ID": {
        "description": "Unique distributed tracing UUID propagated across request lifecycle",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "X-Idempotency-Key": {
        "description": "Client-generated UUIDv4 preventing duplicate debits or mutations",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "type": "object" },
          "meta": { "type": "object" }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "INVALID_CREDENTIALS" },
              "message": { "type": "string", "example": "Invalid email or password" },
              "details": { "type": "object" }
            }
          }
        }
      },
      "MoneyAmount": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]{2}$",
        "example": "25.00",
        "description": "Exact 2-decimal fixed-point numeric string to prevent floating-point drift"
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "firstName": { "type": "string", "example": "Jane" },
          "lastName": { "type": "string", "example": "Doe" },
          "phoneNumber": { "type": "string", "example": "+15551234567" },
          "dateOfBirth": { "type": "string", "format": "date", "example": "1995-06-15" },
          "avatarUrl": { "type": "string", "nullable": true },
          "isVerified": { "type": "boolean", "example": false },
          "hasPin": { "type": "boolean", "example": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Wallet": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "currency": { "type": "string", "example": "USD" },
          "balance": { "$ref": "#/components/schemas/MoneyAmount" },
          "status": { "type": "string", "enum": ["ACTIVE", "FROZEN", "CLOSED"], "example": "ACTIVE" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "TransferReceipt": {
        "type": "object",
        "properties": {
          "transactionId": { "type": "string", "format": "uuid" },
          "transactionReference": { "type": "string", "example": "TXN-20260921-A1B2C3D4" },
          "sender": { "type": "object", "properties": { "id": { "type": "string" } } },
          "receiver": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "firstName": { "type": "string" },
              "lastName": { "type": "string" }
            }
          },
          "amount": { "$ref": "#/components/schemas/MoneyAmount" },
          "fee": { "$ref": "#/components/schemas/MoneyAmount" },
          "currency": { "type": "string", "example": "USD" },
          "status": { "type": "string", "example": "COMPLETED" },
          "category": { "type": "string", "enum": ["Food", "Expense", "Property", "Hobby", "Entertainment"] },
          "note": { "type": "string", "nullable": true },
          "senderBalanceAfter": { "$ref": "#/components/schemas/MoneyAmount" },
          "receiverBalanceAfter": { "$ref": "#/components/schemas/MoneyAmount" },
          "settledAt": { "type": "string", "format": "date-time" }
        }
      },
      "PaymentRequest": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "requesterId": { "type": "string", "format": "uuid" },
          "payerId": { "type": "string", "format": "uuid" },
          "amount": { "$ref": "#/components/schemas/MoneyAmount" },
          "currency": { "type": "string", "example": "USD" },
          "category": { "type": "string" },
          "note": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["PENDING", "COMPLETED", "DECLINED", "CANCELLED"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ChatMessage": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "conversationId": { "type": "string", "format": "uuid" },
          "senderId": { "type": "string", "format": "uuid" },
          "isOutgoing": { "type": "boolean" },
          "content": { "type": "string" },
          "isRead": { "type": "boolean" },
          "transaction": { "type": "object", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "InAppNotification": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "category": { "type": "string", "enum": ["TRANSACTIONS", "PROMOS", "SYSTEM"] },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "isRead": { "type": "boolean" },
          "metadata": { "type": "object" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Application & Supabase Health Probe",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "System operational and Supabase connected",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "User Registration",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "firstName", "lastName"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 },
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "phoneNumber": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created, profile and wallet auto-provisioned" },
          "400": { "description": "Weak password or malformed input" },
          "409": { "description": "Email already in use" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "User Login & Session Token Exchange",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful, returns JWT accessToken and refreshToken" },
          "401": { "description": "Invalid email or password" }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Refresh Expired Access Token",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": { "refreshToken": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Tokens refreshed" },
          "401": { "description": "Invalid or expired refresh token" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Revoke User Session",
        "tags": ["Authentication"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "User logged out successfully" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/auth/pin/status": {
      "get": {
        "summary": "Get Transaction PIN Status & Lockout State",
        "tags": ["PIN Security"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "PIN status retrieved (hasPin, isLocked, remainingAttempts)" }
        }
      }
    },
    "/api/v1/auth/pin/setup": {
      "post": {
        "summary": "Initial 6-Digit PIN Setup (Argon2id)",
        "tags": ["PIN Security"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["pin", "confirmPin"],
                "properties": {
                  "pin": { "type": "string", "pattern": "^\\d{6}$" },
                  "confirmPin": { "type": "string", "pattern": "^\\d{6}$" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "PIN configured" },
          "409": { "description": "PIN already configured" }
        }
      }
    },
    "/api/v1/auth/pin/verify": {
      "post": {
        "summary": "Verify PIN and Issue 5-Minute Single-Use Transaction Ticket",
        "tags": ["PIN Security"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["pin"],
                "properties": { "pin": { "type": "string", "pattern": "^\\d{6}$" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "PIN verified, returns HMAC transactionTicket" },
          "400": { "description": "Incorrect PIN (reports remaining attempts)" },
          "423": { "description": "Locked (3 consecutive failures, 15-min lockout)" }
        }
      }
    },
    "/api/v1/auth/pin/change": {
      "post": {
        "summary": "Change Existing PIN",
        "tags": ["PIN Security"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentPin", "newPin", "confirmNewPin"],
                "properties": {
                  "currentPin": { "type": "string" },
                  "newPin": { "type": "string" },
                  "confirmNewPin": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "PIN updated" }
        }
      }
    },
    "/api/v1/profile/me": {
      "get": {
        "summary": "Retrieve Authenticated User Profile",
        "tags": ["Profile"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } } }
        }
      },
      "patch": {
        "summary": "Update Profile Details",
        "tags": ["Profile"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "dateOfBirth": { "type": "string", "format": "date" },
                  "avatarUrl": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile updated" }
        }
      }
    },
    "/api/v1/wallets": {
      "get": {
        "summary": "List User Wallets with Fixed-Point Balances",
        "tags": ["Wallets"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "wallets": { "type": "array", "items": { "$ref": "#/components/schemas/Wallet" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transfers": {
      "post": {
        "summary": "Execute Atomic P2P Fund Transfer",
        "tags": ["Transfers"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Unique client UUIDv4 for deduplication"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "category"],
                "properties": {
                  "receiverId": { "type": "string", "format": "uuid" },
                  "receiverPhone": { "type": "string" },
                  "receiverEmail": { "type": "string", "format": "email" },
                  "amount": { "type": "number", "minimum": 0.01, "maximum": 2500.00 },
                  "currency": { "type": "string", "default": "USD" },
                  "category": { "type": "string", "enum": ["Food", "Expense", "Property", "Hobby", "Entertainment"] },
                  "note": { "type": "string", "maxLength": 255 },
                  "pin": { "type": "string", "pattern": "^\\d{6}$" },
                  "transactionTicket": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transfer completed atomically",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransferReceipt" } } }
          },
          "400": { "description": "Insufficient funds, AML ceiling exceeded, or bad PIN" },
          "403": { "description": "Account frozen" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/v1/transfers/{reference}": {
      "get": {
        "summary": "Lookup Transfer Receipt by Transaction Reference",
        "tags": ["Transfers"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "reference", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransferReceipt" } } } },
          "403": { "description": "Forbidden: Not the sender or receiver" },
          "404": { "description": "Transfer not found" }
        }
      }
    },
    "/api/v1/requests": {
      "post": {
        "summary": "Create Payment Request",
        "tags": ["Payment Requests"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount"],
                "properties": {
                  "payerId": { "type": "string", "format": "uuid" },
                  "payerPhone": { "type": "string" },
                  "payerEmail": { "type": "string", "format": "email" },
                  "amount": { "type": "number", "minimum": 0.01 },
                  "currency": { "type": "string", "default": "USD" },
                  "category": { "type": "string" },
                  "note": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Payment request created" }
        }
      },
      "get": {
        "summary": "List User Payment Requests (Sent & Received)",
        "tags": ["Payment Requests"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "in": "query", "name": "direction", "schema": { "type": "string", "enum": ["sent", "received", "all"] } },
          { "in": "query", "name": "status", "schema": { "type": "string", "enum": ["PENDING", "COMPLETED", "DECLINED", "CANCELLED"] } },
          { "in": "query", "name": "page", "schema": { "type": "integer", "default": 1 } },
          { "in": "query", "name": "limit", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Paginated payment requests" }
        }
      }
    },
    "/api/v1/requests/{id}/pay": {
      "post": {
        "summary": "Settle Payment Request (Pay Now)",
        "tags": ["Payment Requests"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "in": "header", "name": "X-Idempotency-Key", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pin": { "type": "string", "pattern": "^\\d{6}$" },
                  "transactionTicket": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Request settled atomically" },
          "400": { "description": "Insufficient funds or request not PENDING" }
        }
      }
    },
    "/api/v1/requests/{id}/decline": {
      "post": {
        "summary": "Decline Payment Request (Payer only)",
        "tags": ["Payment Requests"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Request status updated to DECLINED" } }
      }
    },
    "/api/v1/requests/{id}/cancel": {
      "post": {
        "summary": "Cancel Payment Request (Requester only)",
        "tags": ["Payment Requests"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Request status updated to CANCELLED" } }
      }
    },
    "/api/v1/cards": {
      "get": {
        "summary": "List User Tokenized Saved Cards",
        "tags": ["Cards"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "List of tokenized card references (PCI-DSS compliant)" } }
      },
      "post": {
        "summary": "Register Gateway-Tokenized Card",
        "tags": ["Cards"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["gateway_payment_method_id", "brand", "last4", "expiry_month", "expiry_year"],
                "properties": {
                  "gateway_payment_method_id": { "type": "string" },
                  "brand": { "type": "string" },
                  "last4": { "type": "string", "pattern": "^\\d{4}$" },
                  "expiry_month": { "type": "integer", "minimum": 1, "maximum": 12 },
                  "expiry_year": { "type": "integer", "minimum": 2026 },
                  "is_default": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Card registered" },
          "400": { "description": "Raw card fields strictly rejected (PCI_DSS_VIOLATION)" }
        }
      }
    },
    "/api/v1/cards/{id}": {
      "delete": {
        "summary": "Delete Tokenized Card",
        "tags": ["Cards"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Card removed" } }
      }
    },
    "/api/v1/cards/{id}/default": {
      "patch": {
        "summary": "Set Default Payment Card",
        "tags": ["Cards"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Default card updated" } }
      }
    },
    "/api/v1/top-up/intent": {
      "post": {
        "summary": "Create Gateway Payment Intent for Wallet Top-Up",
        "tags": ["Top-Up"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount"],
                "properties": {
                  "amount": { "type": "number", "minimum": 1.00 },
                  "currency": { "type": "string", "default": "USD" },
                  "cardId": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Payment intent created with clientSecret" }
        }
      }
    },
    "/api/v1/webhooks/payments": {
      "post": {
        "summary": "Asynchronous Payment Gateway Settlement Webhook",
        "tags": ["Webhooks"],
        "security": [{ "WebhookSignature": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": {
          "200": { "description": "Webhook processed, balance credited atomically" },
          "401": { "description": "Invalid or expired cryptographic signature" }
        }
      }
    },
    "/api/v1/analytics/cash-flow": {
      "get": {
        "summary": "Retrieve Cash Flow Analytics & Aggregations",
        "tags": ["Analytics"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "in": "query", "name": "period", "required": true, "schema": { "type": "string", "enum": ["weekly", "monthly", "yearly"] } },
          { "in": "query", "name": "start_date", "schema": { "type": "string", "format": "date" } },
          { "in": "query", "name": "end_date", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": { "description": "Summary metrics, category breakdown, chart time-series" }
        }
      }
    },
    "/api/v1/conversations": {
      "get": {
        "summary": "List User Conversations with Previews & Unread Counts",
        "tags": ["Conversations & Chat"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "in": "query", "name": "page", "schema": { "type": "integer", "default": 1 } },
          { "in": "query", "name": "limit", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Conversations list" } }
      },
      "post": {
        "summary": "Get or Create Conversation with Counterparty",
        "tags": ["Conversations & Chat"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["counterpartyId"],
                "properties": { "counterpartyId": { "type": "string", "format": "uuid" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Existing or newly created conversation thread" } }
      }
    },
    "/api/v1/conversations/{id}/messages": {
      "get": {
        "summary": "Get Chronological Paginated Message History",
        "tags": ["Conversations & Chat"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "in": "query", "name": "page", "schema": { "type": "integer", "default": 1 } },
          { "in": "query", "name": "limit", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Messages history with embedded transaction cards" } }
      },
      "post": {
        "summary": "Send Chat Message (with optional embedded transactionId)",
        "tags": ["Conversations & Chat"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["content"],
                "properties": {
                  "content": { "type": "string", "maxLength": 2000 },
                  "transactionId": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Message created and broadcast over Realtime" } }
      }
    },
    "/api/v1/notifications": {
      "get": {
        "summary": "List In-App Notifications",
        "tags": ["Notifications"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "in": "query", "name": "category", "schema": { "type": "string", "enum": ["TRANSACTIONS", "PROMOS", "SYSTEM"] } },
          { "in": "query", "name": "is_read", "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "description": "Filtered notifications list with unread counter" } }
      }
    },
    "/api/v1/notifications/{id}/read": {
      "patch": {
        "summary": "Mark Single Notification as Read",
        "tags": ["Notifications"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Notification updated" } }
      }
    },
    "/api/v1/notifications/read-all": {
      "post": {
        "summary": "Mark All Notifications as Read",
        "tags": ["Notifications"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "category": { "type": "string", "enum": ["TRANSACTIONS", "PROMOS", "SYSTEM"] } }
              }
            }
          }
        },
        "responses": { "200": { "description": "All notifications marked read" } }
      }
    },
    "/api/v1/users/device-token": {
      "post": {
        "summary": "Register FCM Device Token for Push Alerts",
        "tags": ["Notifications"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": { "type": "string" },
                  "platform": { "type": "string", "enum": ["android", "ios", "web"], "default": "android" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Token registered" } }
      }
    }
  }
}
